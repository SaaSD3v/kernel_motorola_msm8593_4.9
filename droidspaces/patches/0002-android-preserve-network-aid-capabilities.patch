From 9a7416218ae637c4120c417b31428bb0747fdfdf Mon Sep 17 00:00:00 2001
From: SaaSD3v <hearesaas@gmail.com>
Date: Fri, 11 Sep 2026 00:00:00 +0000
Subject: [PATCH] android: preserve network AID capabilities with paranoid net off

DroidSpaces requires CONFIG_ANDROID_PARANOID_NETWORK=n on older Android
kernels for container networking. Keep the legacy Android AID_NET_RAW and
AID_NET_ADMIN capability fallback active so Oreo Wi-Fi/network services do
not regress when that Kconfig gate is disabled.
---
 security/commoncap.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/security/commoncap.c b/security/commoncap.c
--- a/security/commoncap.c
+++ b/security/commoncap.c
@@ -30,9 +30,7 @@
 #include <linux/binfmts.h>
 #include <linux/personality.h>
 
-#ifdef CONFIG_ANDROID_PARANOID_NETWORK
 #include <linux/android_aid.h>
-#endif
 
 /*
  * If a non-root user executes a setuid-root binary in
@@ -103,7 +101,6 @@ int cap_capable(const struct cred *cred, struct user_namespace *targ_ns,
 {
 	int ret = __cap_capable(cred, targ_ns, cap, audit);
 
-#ifdef CONFIG_ANDROID_PARANOID_NETWORK
 	if (ret != 0 && cap == CAP_NET_RAW && in_egroup_p(AID_NET_RAW)) {
 		printk("Process %s granted CAP_NET_RAW from Android group net_raw.\n", current->comm);
 		printk("  Please update the .rc file to explictly set 'capabilities NET_RAW'\n");
@@ -118,7 +115,6 @@ int cap_capable(const struct cred *cred, struct user_namespace *targ_ns,
 		printk("  Implicit grants are deprecated and will be removed in the future.\n");
 		return 0;
 	}
-#endif
 	return ret;
 }
